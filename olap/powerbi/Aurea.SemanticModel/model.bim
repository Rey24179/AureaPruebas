        "lineageTag": "c72765bb-c9f4-44a8-b65a-228b831b4c25",
        "measures": [
          {
            "name": "Ventas Q",
            "displayFolder": "Indicadores",
            "expression": "SUM(Ventas[importe])",
            "formatString": "\"Q\" #,0.00",
            "lineageTag": "1a319eb8-4cf7-4fff-bdaf-e668a6635b01"
          },
          {
            "name": "Compras",
            "displayFolder": "Indicadores",
            "expression": "DISTINCTCOUNT(Ventas[compra_clave])",
            "formatString": "#,0",
            "lineageTag": "b2d7b184-df4a-4290-96a9-05074c702717"
          },
          {
            "name": "Unidades",
            "displayFolder": "Indicadores",
            "expression": "SUM(Ventas[cantidad])",
            "formatString": "#,0",
            "lineageTag": "5395055b-89b1-4812-8d4d-f2f51b13f591"
          },
          {
            "name": "Ticket promedio Q",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE([Ventas Q], [Compras])",
            "formatString": "\"Q\" #,0.00",
            "lineageTag": "572716f0-67e8-4e35-9dff-3a265dd0e373"
          },
          {
            "name": "Precio medio Q",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE([Ventas Q], [Unidades])",
            "formatString": "\"Q\" #,0.00",
            "lineageTag": "8206e9b7-c848-4c4d-a1b5-ed0249139aae"
          },
          {
            "name": "Clientes identificados",
            "displayFolder": "Indicadores",
            "expression": "CALCULATE(DISTINCTCOUNT(Ventas[cliente_id]), Ventas[cliente_identificado] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "4cb7ccb5-eed5-430a-b1d5-2254805468e8"
          },
          {
            "name": "Dias con ventas",
            "displayFolder": "Indicadores",
            "expression": "DISTINCTCOUNT(Ventas[fecha])",
            "formatString": "#,0",
            "lineageTag": "9770c325-3d79-46be-baa0-dd2b57e476e4"
          },
          {
            "name": "Ventas por dia Q",
            "displayFolder": "Indicadores",
            "expression": "DIVIDE([Ventas Q], [Dias con ventas])",
            "formatString": "\"Q\" #,0.00",
            "lineageTag": "1efa3a97-feb7-47f5-b58b-f5397caaab2c"
          }
        ],
        "partitions": [
          {
            "name": "Ventas",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fuente = PostgreSQL.Database(Servidor, BaseDatos, [CreateNavigationProperties=false]),",
                "    Ventas = Fuente{[Schema=\"datamart\",Item=\"v_ventas_analisis\"]}[Data],",
                "    Tipos = Table.TransformColumnTypes(Ventas, {{\"fecha\", type date}, {\"importe\", Currency.Type}, {\"precio_unitario\", Currency.Type}})",
                "in",
                "    Tipos"
              ],
              "type": "m"
            }
          }
        ]
      },
